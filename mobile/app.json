{
  "expo": {
    "name": "Pica",
    "slug": "pica",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "scheme": "pica",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1A1814"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.lechakrawarthy.pica",
      "buildNumber": "1"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1A1814"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.lechakrawarthy.pica",
      "versionCode": 1,
      "permissions": [
        "INTERNET"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "f667073a-95bb-48fd-855b-a1292001465b"
      }
    }
  }
}
